@@ -7703,9 +7704,24 @@ int FrFileIOpenOSDF(FrFile *file)
     FrError(3, "FrFileIOpenOSDF", errmsg);
     file->error = FR_ERROR_OPEN_ERROR;
     return(3);}
+  // Copy the filename part before freeing
+  const char* fname_part = start + 1;
+  char fname_buf[512];
+  snprintf(fname_buf, sizeof(fname_buf), "%s", fname_part);
   free(file->current->fileName);
